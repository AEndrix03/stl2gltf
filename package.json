{
  "name": "stl2glb-service",
  "version": "1.0.0",
  "description": "High-performance STL to GLB conversion service with MinIO storage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:cpp": "mkdir -p build && cd build && cmake .. && make",
    "test": "jest",
    "docker:build": "docker build -t stl2glb-service .",
    "docker:run": "docker-compose up",
    "health": "curl -f http://localhost:9002/health"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "minio": "^7.1.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "stl",
    "glb",
    "gltf",
    "3d",
    "conversion",
    "minio",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT"
}
